model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Fato

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensao

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dImovel","dLead","dVendedores","fFaturamento","fFunil","fMeta","Medidas","Diretorio","auxMeta"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

ref table dImovel
ref table dLead
ref table dVendedores
ref table fFaturamento
ref table fFunil
ref table dCalendario
ref table Medidas
ref table fMeta
ref table auxMeta
ref table auxBlank

ref cultureInfo pt-BR

